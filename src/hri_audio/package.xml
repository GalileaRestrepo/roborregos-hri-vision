<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hri_audio</name>
  <version>0.0.1</version>
  <description>Nodos de audio: captura, VAD, transcripción, identidad de voz</description>
  <maintainer email="gali@roboborregos.com">gali</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>python3-sounddevice</depend>
  <depend>python3-torch</depend>
  <depend>python3-numpy</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>hri_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
